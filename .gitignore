node_modules/
dist/
.DS_Store
*.local
.vite/

# Secrets. `*.local` above already covers .env.local, but a bare `.env` is the
# easy mistake — it is the file most people reach for, and the service-role key
# that belongs in it bypasses every row-level security policy in the project.
# .env.example is the committed template and holds no values.
.env
.env.*
!.env.example

# Vendored C++ dependency. Cloned and built by scripts/build-akochan.sh, which is
# the committed record of how; the tree itself is ~500MB of sources and objects.
vendor/

# Pipeline working data — never commit multi-GB log dumps
pipeline/data/
pipeline/.venv/
pipeline/**/__pycache__/
*.mjson
*.mjson.gz
*.db

# TypeScript incremental build cache
tsconfig.tsbuildinfo
