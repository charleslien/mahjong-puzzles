# Supabase configuration — template. Copy to .env.local and fill in.
#
#   cp .env.example .env.local
#
# .env.local is gitignored; this file is committed and must never hold real
# values. Vite loads .env.local automatically for `npm run dev` and `npm run
# build`. For production, set the VITE_ vars in the Vercel dashboard as well —
# Vercel does not read this file.
#
# Find these under Project Settings -> API Keys in the Supabase dashboard.
#
# Naming note: these are the current key names. Older projects and most tutorials
# still say "anon" (now publishable) and "service_role" (now secret); they play
# the same two roles. The newer keys can also be rotated or revoked individually,
# where revoking a legacy service_role key meant rotating the project's JWT secret
# and invalidating everything at once.
#
# ---------------------------------------------------------------------------
# THE ONE RULE: anything named VITE_* is compiled into the JavaScript bundle and
# is public. Not "hard to find" — literally readable in the shipped source by
# anyone who opens devtools. Only the publishable key may ever carry that prefix.
# Prefixing the secret key with VITE_ would hand every visitor the ability to
# read and rewrite the whole database, because that key bypasses row-level
# security by design.
# ---------------------------------------------------------------------------


# --- Public: shipped to the browser ---------------------------------------

# Project URL, e.g. https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=

# Publishable key (sb_publishable_...). Safe to expose *provided* row-level
# security is enabled on every table — RLS is what makes it safe, not the key
# itself. A table without an RLS policy is world-readable and world-writable
# with this key.
VITE_SUPABASE_PUBLISHABLE_KEY=


# --- Private: local pipeline and server only, never VITE_ prefixed ---------

# Secret key (sb_secret_...). Bypasses row-level security entirely.
# Used only by the offline pipeline to bulk-upload the puzzle bank
# (scripts/upload-bank.ts), which runs on your machine, never in a browser.
# Leave blank unless you are uploading puzzles.
SUPABASE_SECRET_KEY=

# Postgres connection, for running migrations with psql. Optional — only needed
# to apply schema changes.
#
# Prefer the *session pooler* string from Dashboard -> Connect. The direct
# `db.<ref>.supabase.co` host resolves to IPv6 only, so it works from a network
# with IPv6 and stops working from one without, with a DNS error that looks like
# the host has gone away:
#
#   postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres
#
# Note the username is postgres.<ref>, not postgres.
#
# If the password contains a `#`, quote the whole value or urlencode it — an
# unencoded `#` starts a URL fragment and silently truncates the connection
# string for anything stricter than libpq.
SUPABASE_DB_URL=


# --- Behaviour -------------------------------------------------------------

# Where the site reads puzzles from.
#   static   bundled JSON in public/puzzles (current behaviour, no backend)
#   supabase query the database, falling back to static on any failure
#
# Defaults to "static" when unset or when the two VITE_SUPABASE_* values above
# are missing, so a clone with no .env.local behaves exactly as the site does
# today. The fallback is deliberate: a database outage should degrade the site to
# its current behaviour, not blank the page.
VITE_PUZZLE_SOURCE=static
